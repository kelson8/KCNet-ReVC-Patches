+/**
+ * Check if the save slot is valid
+ * This will check if my custom ReVC save slot is valid.
+ * Mostly checks if the filename lowercase/capital letters, numbers and '-', '_'
+ * 
+ * @param slot
+ */
+bool FreeroamUtil::IsValidSaveSlot(std::string_view slot)
+{
+    if (slot.empty() || slot.size() > MAX_SAVE_FILE_NAME)
+        return false;
+
+    for (char c : slot)
+    {
+        const bool allowed =
+            (c >= 'a' && c <= 'z') ||
+            (c >= 'A' && c <= 'Z') ||
+            (c >= '0' && c <= '9') ||
+            c == '_' || c == '-';
+
+        if (!allowed)
+            return false;
+    }
+
+    return true;
+}
