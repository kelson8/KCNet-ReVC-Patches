+/**
+ * Start the thread for the tick
+ * Should work for a COMMAND_WAIT implementation.
+ * 
+ * TODO Test this later.
+ */
+void LuaTest::StartOnTick()
+{
+    lua_State* threadState = lua_newthread(m_luaVM);
+
+    // Keep the coroutine alive through the registry.
+    int reference = luaL_ref(m_luaVM, LUA_REGISTRYINDEX);
+
+    // Get the global OnTick function from the main Lua state.
+    lua_getglobal(m_luaVM, "OnTick");
+
+    if (!lua_isfunction(m_luaVM, -1)) {
+        lua_pop(m_luaVM, 1);
+
+        luaL_unref(
+            m_luaVM,
+            LUA_REGISTRYINDEX,
+            reference
+        );
+
+        LogFunctions::LogError(
+            Defines::logFile,
+            "Lua function OnTick was not found"
+        );
+
+        return;
+    }
+
+    // Move OnTick from the main state's stack to the coroutine stack.
+    lua_xmove(m_luaVM, threadState, 1);
+
+    LuaThread thread;
+    thread.state = threadState;
+    thread.registryReference = reference;
+    thread.waiting = false;
+    thread.finished = false;
+
+    m_threads.push_back(thread);
+
+    LuaThread& addedThread = m_threads.back();
+
+    int result = 0;
+
+#if LUA_VERSION_NUM >= 504
+    int resultCount = 0;
+
+    result = lua_resume(
+        threadState,
+        nullptr,
+        0,
+        &resultCount
+    );
+#else
+    result = lua_resume(
+        threadState,
+        nullptr,
+        0
+    );
+#endif
+
+    if (result == LUA_YIELD) {
+        // wait() normally brings execution here.
+        return;
+    }
+
+    if (result == LUA_OK) {
+        addedThread.finished = true;
+        return;
+    }
+
+    const char* error = lua_tostring(threadState, -1);
+
+    LogFunctions::LogError(
+        Defines::logFile,
+        error ? error : "Lua OnTick failed"
+    );
+
+    lua_settop(threadState, 0);
+    addedThread.finished = true;
+}
+
