+
+/**
+ * Force change the weather.
+ * 
+ * Usage:
+ * game.force_weather(weatherType)
+ */
+int forceWeatherLua(lua_State *L)
+{
+	// int weatherType = luaGetNumber(L, 1);
+
+	int weatherType = lua_tonumber(L, 1);
+
+	if(weatherType < WEATHER_SUNNY || weatherType > WEATHER_HURRICANE) 
+	{
+		return luaL_error(L, "game.force_weather requires a value from the weather_enums.eWeatherType enum.");
+	}
+
+	CWeather::ForceWeather(weatherType);
+
+	return 1;
+}
+
+/**
+ * Force change the weather now.
+ * 
+ * Usage:
+ * game.force_weather_now(weatherType)
+ */
+int forceWeatherNowLua(lua_State *L)
+{
+	int weatherType = lua_tonumber(L, 1);
+
+	if(weatherType < WEATHER_SUNNY || weatherType > WEATHER_HURRICANE) 
+	{
+		return luaL_error(L, "game.force_weather_now requires a value from the weather_enums.eWeatherType enum.");
+	}
+
+	CWeather::ForceWeatherNow(weatherType);
+	return 1;
+}
+
+/**
+ * Release the current weather type.
+ * 
+ * Usage:
+ * game.release_weather(weatherType)
+ */
+int releaseWeatherLua(lua_State *L)
+{
+	CWeather::ReleaseWeather();
+
+	return 1;
+}
+
