+/**
+ * Display the players position in ImGui.
+ */
+void WarpMenu::DisplayPosition()
+{
+	CVector playerCoords = FindPlayerPed()->GetPosition();
 
+	ImGui::Separator();
+	ImGui::Text("Position");
+	// This seems to show up the current coordinates on the screen.
+	std::string playerPositionMessage = "X: " + std::to_string(playerCoords.x) 
+		+ " Y: " + std::to_string(playerCoords.y) 
+		+ " Z: " + std::to_string(playerCoords.z);
+	ImGui::Text(playerPositionMessage.c_str());
+}
 
