+/**
+ * Setup the target marker for freeroam when loading.
+ *
+ * @param targetMarkerPos The target marker position.
+ *
+ * @returns The blip ID for the created target marker.
+ */
+int
+FreeroamUtil::SetupTargetMarker(CVector targetMarkerPos)
+{
+
+	if(CRadar::TargetMarkerId == -1) {
+
+		// New, taken from CRadar::SetCoordBlip
+		// This works! It checks if the blip is in use before overwriting it, unlike what I was doing.
+		int nextBlip;
+		for(nextBlip = 0; nextBlip < NUMRADARBLIPS; nextBlip++) {
+			// Make sure this blip isn't in use, if it is don't use that slot.
+			if(!CRadar::ms_RadarTrace[nextBlip].m_bInUse) break;
+		}
+
+		if(nextBlip == NUMRADARBLIPS) return -1;
+		//
+
+        // Setup the properties for the target marker.
+		CRadar::ms_RadarTrace[nextBlip].m_eBlipType = BLIP_COORD;
+		CRadar::ms_RadarTrace[nextBlip].m_nColor = RADAR_TRACE_GRAY;
+		CRadar::ms_RadarTrace[nextBlip].m_bDim = 0;
+		CRadar::ms_RadarTrace[nextBlip].m_bInUse = 1;
+		CRadar::ms_RadarTrace[nextBlip].m_Radius = 1.0f;
+		CRadar::ms_RadarTrace[nextBlip].m_vec2DPos = targetMarkerPos;
+		CRadar::ms_RadarTrace[nextBlip].m_vecPos = targetMarkerPos;
+		CRadar::ms_RadarTrace[nextBlip].m_nEntityHandle = 0;
+		CRadar::ms_RadarTrace[nextBlip].m_wScale = 5;
+		CRadar::ms_RadarTrace[nextBlip].m_eBlipDisplay = BLIP_DISPLAY_BLIP_ONLY;
+        CRadar::ms_RadarTrace[nextBlip].m_eRadarSprite = RADAR_SPRITE_WAYPOINT;
+
+        // Set the target marker ID, otherwise it cannot be removed.
+        CRadar::TargetMarkerId = CRadar::GetNewUniqueBlipIndex(nextBlip);
+        CRadar::TargetMarkerPos = targetMarkerPos;
+
+		return nextBlip;
+	}
+	return 0;
+}
 
