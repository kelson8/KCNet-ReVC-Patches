+#endif // DISABLE_GAME_SCRIPTS - Fix for audio bug on new game.
+
 		} else if (hasNativeList(m_nCurrScreen)) {
 			switch (m_nCurrExLayer) {
 			case HOVEROPTION_LIST:
@@ -5162,7 +5179,15 @@ CMenuManager::ProcessUserInput(uint8 goDown, uint8 goUp, uint8 optionSelected, u
