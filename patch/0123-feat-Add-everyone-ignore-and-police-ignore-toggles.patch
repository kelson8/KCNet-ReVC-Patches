+//------------------
+// New toggles
+// Added in: v1.12-11a
+//------------------
+
+/**
+ * Toggle the players control, can enable/disable their movement.
+ * SET_PLAYER_CONTROL
+ * 
+ * TODO Fix this one
+ * 
+ * 
+ * 
+ * Usage:
+ * player.set_control(true)
+ * 
+ */
+int 
+togglePlayerControlLua(lua_State *L)
+{
+	bool toggle = static_cast<float>(lua_toboolean(L, 1));
+
+	if(!lua_isboolean(L, 1))
+	{
+		return luaL_error(L, "player.toggle_control requires a boolean true or false value.");
+	}
+
+	// I need to figure this out.
+	// FindPlayerPed()->MakePlayerSafe(false);
+
+
+
+	return 1;
+}
+
+
+/**
+ * Toggle everyone ignores the player
+ * SET_EVERYONE_IGNORE_PLAYER
+ * 
+ * Usage:
+ * player.everyone_ignore(true)
+ * 
+ */
+int 
+toggleEveryoneIgnorePlayerLua(lua_State *L)
+{
+	bool toggle = static_cast<float>(lua_toboolean(L, 1));
+
+	if(!lua_isboolean(L, 1))
+	{
+		return luaL_error(L, "player.everyone_ignore requires a boolean true or false value.");
+	}
+
+	FindPlayerPed()->m_pWanted->m_bIgnoredByEveryone = toggle;
+
+	if(toggle)
+	{
+		CWorld::StopAllLawEnforcersInTheirTracks();
+	}
+
+	return 1;
+}
+
+
+/**
+ * Toggle police ignores the player
+ * SET_POLICE_IGNORE_PLAYER
+ * 
+ * Usage:
+ * player.police_ignore_player(true)
+ * 
+ */
+int 
+togglePoliceIgnorePlayerLua(lua_State *L)
+{
+	bool toggle = static_cast<float>(lua_toboolean(L, 1));
+
+	// TODO Is this right?
+	if(!lua_isboolean(L, 1))
+	{
+		return luaL_error(L, "player.police_ignore requires a boolean true or false value.");
+	}
+
+	CPlayerPed *playerPed = FindPlayerPed();
+
+	// if(!playerPed)
+	// {
+	// 	return luaL_error(L, "player.police_ignore_player Player doesnt exist!");
+	// }
+
+	playerPed->m_pWanted->m_bIgnoredByCops = toggle;
+	if(toggle)
+	{
+		CWorld::StopAllLawEnforcersInTheirTracks();
+	}
+
+	// FindPlayerPed()->m_pWanted.
+	// 
+
+	// togglePoliceIgnorePlayer
+
+
+
+	return 1;
+}
+
 #endif // LUA_TEST
