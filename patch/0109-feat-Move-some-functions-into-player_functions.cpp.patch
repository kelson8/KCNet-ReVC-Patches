+/**
+ * Give a player a weapon.
+ * This format works! It looks up the model index name from the WeaponModels std::map.
+ */
+void
+PlayerFunctions::GiveWeapon(eWeaponType weapon, int ammo)
+{
+    auto it = WeaponModels.find(weapon);
+
+    if (it == WeaponModels.end())
+    {
+        TRACE("Error: The weapon doesn't exist in the WeaponModels list.");
+        // No model exists for this weapon type.
+        return;
+    }
+
+    const int modelIndex = it->second;
+
+    CStreaming::RequestModel(modelIndex, STREAMFLAGS_DONT_REMOVE);
+
+    // while (!CStreaming::HasModelLoaded(modelIndex))
+    // {
+    CStreaming::LoadAllRequestedModels(false);
+    // }
+
+    CPlayerPed* ped = FindPlayerPed();
+
+    if (!ped)
+        return;
+
+    ped->GiveWeapon(weapon, ammo, true);
+}
+
+/**
+ * Teleport the player, named warp in here.
+ * Idea came from from teleport.cpp in the user-grinch Cheat Menu.
+ * 
+ * This teleports the player to the specified position and interior id.
+ * Takes a CVector for the position.
+ * Use PlayerUtil::PlayerCoords() to get the current position
+ * Also use PlayerUtil::PlayerHeading() to get the current heading
+ *
+ * @param pos A CVector for the position to warp to
+ * @param interiorID The interior ID, currently my custom scripts don't support interiors.
+ */
+void
+PlayerFunctions::Warp(CVector &pos, int interiorID)
+{
+	CPlayerPed *pPed = FindPlayerPed();
+	VehicleFunctions vehicleFunctions = VehicleFunctions();
+
+    // Load the scene
+	CStreaming::LoadScene(pos);
+	CStreaming::LoadSceneCollision(pos);
+
+    // Load all models
+	CStreaming::LoadAllRequestedModels(false);
+
+
+    // Vehicle check, teleport the players vehicle if they are in one.
+	if(vehicleFunctions.IsPlayerInVehicle()) 
+	{
+		CVehicle *pVeh = pPed->m_pMyVehicle;
+		pVeh->m_area = interiorID;
+		pVeh->Teleport(pos);
+	} else {
+		pPed->Teleport(pos);
+	}
+
+    // Set the players interior.
+	pPed->m_area = interiorID;
+}
+
