+/**
+ * Override the respawn point for the next spawn.
+ * This is mostly used where I set the wasted and busted respawns.
+ * 
+ * Usage:
+ * 
+ * game.override_next_restart({x = 25, y = 25, z = 25}, heading)
+ */
+int overrideRestartLua(lua_State *L)
+{
+	auto pos = luaGetCVector(L, 1);
+	auto heading = lua_tonumber(L, 2);
+
+	if(!pos)
+	{
+		return luaL_error(L, "game.override_next_restart requires a Vector table with an x, y, and z.");
+	}
+
+	if(heading < 0.0f || heading > 320.0f)
+	{
+		return luaL_error(L, "game.override_next_restart, heading can be between 0.0 and 320.0.");
+	}
+
+	CRestart::OverrideNextRestart(*pos, heading);
+
+	return 0;
+}
+
+/**
+ * Cancel an override for the spawn point.
+ * 
+ * Usage:
+ * game.cancel_override_restart()
+ */
+int cancelOverrideRestartLua(lua_State *L)
+{
+	CRestart::CancelOverrideRestart();
+	return 0;
+}
