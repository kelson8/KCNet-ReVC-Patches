+	/**
+	 * Setup a target marker for loading the json save file in lua.
+	 * 
+	 * Usage:
+	 * world.set_marker({x = 25, y = 25, z = 25})
+	 */
+	int setupTargetMarkerLua(lua_State *L)
+	{
+		auto targetMarkerPos = luaGetCVector(L, 1);
+
+		if(!targetMarkerPos)
+		{
+			return luaL_error(L, "world.set_marker expects one vector table with x, y and z values");
+		}
+
+		int targetMarker = FreeroamUtil::SetupTargetMarker(*targetMarkerPos);
+
+		// TODO Make this return the target marker ID, for later use.
+		lua_pushinteger(L, targetMarker);
+
+		return 1;
+	}
+
+	/**
+	 * This will get the current blip index in lua once I set it up.
+	 * 
+	 */
+	int getBlipIndexLua(lua_State *L)
+	{
+		return 1;
+	}
