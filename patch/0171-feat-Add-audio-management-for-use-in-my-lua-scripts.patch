+            CPed* ped = CPools::GetPedPool()->GetSlot(i);
+			if (!ped)
+				continue;
+			if (CTheScripts::LastRandomPedId == CPools::GetPedPool()->GetIndex(ped))
+				continue;
+			if (ped->CharCreatedBy != RANDOM_CHAR)
+				continue;
+			if (!ped->IsPedInControl())
+				continue;
+			if (ped->bRemoveFromWorld)
+				continue;
+			if (ped->bFadeOut)
+				continue;
+            // TODO Add this check.
+			// if (!ThisIsAValidRandomPed(pPed->m_nPedType))
+				// continue;
+			if (ped->bIsLeader || ped->m_leader)
+				continue;
+			if (!ped->IsWithinArea(x1, y1, x2, y2))
+				continue;
+			if (pos.z - PED_FIND_Z_OFFSET > ped->GetPosition().z)
+				continue;
+			if (pos.z + PED_FIND_Z_OFFSET < ped->GetPosition().z)
+				continue;
+
+			pedHandle = CPools::GetPedPool()->GetIndex(ped);
+			CTheScripts::LastRandomPedId = pedHandle;
+			ped->CharCreatedBy = MISSION_CHAR;
+			ped->bRespondsToThreats = false;
+
+            // TODO Why is this here for?
+			++CPopulation::ms_nTotalMissionPeds;
+
+            // TODO Test returning the ped handle
+            pushIntToLua(L, pedHandle);
+
+            // Not used
+			// if (m_bIsMissionScript)
+				// CTheScripts::MissionCleanUp.AddEntityToList(pedHandle, CLEANUP_CHAR);
+            
+        }
+
+        /*
+    
+		int i = CPools::GetPedPool()->GetSize();
+		while (--i && ped_handle == -1){
+			CPed* pPed = CPools::GetPedPool()->GetSlot(i);
+			if (!pPed)
