new file mode 100644
index 00000000..866e07f7
--- /dev/null
+++ b/gamefiles/ViceExtended/ImGui-Controls.ini
@@ -0,0 +1,59 @@
+[Control]
+; This reads the values for the ImGui menu toggle on controller
+ImGuiButton1=256 ; XINPUT_GAMEPAD_RIGHT_SHOULDER
+ImGuiButton2=8 ; XINPUT_GAMEPAD_DPAD_RIGHT
+
+
+; Here are a list of keybinds for XINPUT below:
+; DPad-Up = 1
+; DPad-Down = 2
+; Dpad-Left = 4
+; Dpad-Right = 8
+; Start = 16
+; Back = 32
+; Left Thumb (LB I think) = 64
+; Right Thumb (RB I think) = 128
+; Left Shoulder (LT) = 256
+; Right Shoulder (RB) = 512
+; A = 4096
+; B = 8192
+; X = 16384
+; Y = 32768
+
+; Values with their name and header contents
+
+; XINPUT_GAMEPAD_DPAD_UP: 0x0001 (1)
+; XINPUT_GAMEPAD_DPAD_DOWN: 0x0002 (2)
+; XINPUT_GAMEPAD_DPAD_LEFT: 0x0004 (4)
+; XINPUT_GAMEPAD_DPAD_RIGHT: 0x0008 (8)
+; XINPUT_GAMEPAD_START: 0x0010 (16)
+; XINPUT_GAMEPAD_BACK: 0x0020 (32)
+; XINPUT_GAMEPAD_LEFT_THUMB: 0x0040 (64)
+; XINPUT_GAMEPAD_RIGHT_THUMB: 0x0080 (128)
+; XINPUT_GAMEPAD_LEFT_SHOULDER: 0x0100 (256)
+; XINPUT_GAMEPAD_RIGHT_SHOULDER: 0x0200 (512)
+; XINPUT_GAMEPAD_A: 0x1000 (4096)
+; XINPUT_GAMEPAD_B: 0x2000 (8192)
+; XINPUT_GAMEPAD_X: 0x4000 (16384)
+; XINPUT_GAMEPAD_Y: 0x8000 (32768)
+
+
+; TODO Add the toggle key for windows to be configurable in here also if possible.
+; I'm using rsF8 in the C++ code though.
+
+;;
+
+; C++ code for ImGui with keyboard:
+#define KEYDOWN(k) ControlsManager.GetIsKeyboardKeyDown((RsKeyCodes)k)
+
+
+;								// This works without lua
+;						        static int newTime = 0;
+;
+;								// TODO Make this get controller input also.
+;						        if(KEYDOWN(rsF8) && CTimer::GetTimeInMilliseconds() - newTime > 500) {
+;							        newTime = CTimer::GetTimeInMilliseconds();
+;
+;									// Toggle ImGui
+;									imGuiFunctions.ImGuiDone = !imGuiFunctions.ImGuiDone;
+;								}
