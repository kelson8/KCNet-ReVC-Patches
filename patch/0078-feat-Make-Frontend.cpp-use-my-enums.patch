+			CTheScripts::ScriptToLoad = SCRIPT_FREEROAM_MIAMI;
+#else
 			CTheScripts::ScriptToLoad = 1;
+#endif // CUSTOM_CODE - For new script enums
+
 			DoSettingsBeforeStartingAGame();
 			return;
 		}
@@ -5736,7 +5749,15 @@ CMenuManager::ProcessFileActions()
 #endif
 			if (CheckSlotDataValid(m_nCurrSaveSlot)) {
 #ifdef USE_DEBUG_SCRIPT_LOADER
-				CTheScripts::ScriptToLoad = 0;
+				// TODO Change this in here, I didn't know this was also set here.
+				// Make this use a new variable that can be changed in the ini.
+
+#ifdef CUSTOM_CODE
+			// CTheScripts::ScriptToLoad = SCRIPT_RELEASE;
+			CTheScripts::ScriptToLoad = SCRIPT_RELEASE;
+#else
+			CTheScripts::ScriptToLoad = 0;
+#endif // CUSTOM_CODE - For new script enums
 #endif
 
