         FindPlayerPed()->m_fArmour = value;
     }
 }
+
+/**
+ * This can toggle the players controls on or off.
+ * 
+ * Originally adapted from ImGuiSetup::EnablePlayerControl() and ImGuiSetup::DisablePlayerControl()
+ * 
+ * @param toggle If the players controls are enabled or not.
+ */
+void
+PlayerFunctions::SetControl(bool toggle)
+{
+    if(toggle)
+	{
+		CPad::GetPad(0)->SetEnablePlayerControls(PLAYERCONTROL_CUTSCENE);
+	}
+	else 
+	{
+		CPad::GetPad(0)->SetDisablePlayerControls(PLAYERCONTROL_CUTSCENE);
+	}
+}
