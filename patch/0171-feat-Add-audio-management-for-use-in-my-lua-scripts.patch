diff --git a/src/extras/lua/lua_audio.cpp b/src/extras/lua/lua_audio.cpp
new file mode 100644
index 00000000..4a8c7884
--- /dev/null
+++ b/src/extras/lua/lua_audio.cpp
@@ -0,0 +1,105 @@
+#include "pch.h"
+
+#ifdef LUA_TEST
+#include "lua_audio.h"
+
+// Lua functions
+#include "lua_functions.h"
+
+#include "lua_test.h"
+// Helpers, so far just gets the singleton
+#include "lua_helpers.h"
+
+#include "player_util.h"
+
+#include "defines.h"
+#include "log_functions.h"
+
+#include "custom_cheats.h"
+
+#include "DMAudio.h"
+#include "Frontend.h"
+#include "ini_functions.h"
+
+#include "sampman.h"
+
+// clang-format off
+//------- Audio functions for scripts --------//
+extern "C" 
+{
+
+	/** 
+ 	* Register the audio lua functions under the 'audio' namespace.
+ 	*/
+	void RegisterAudioFunctionsLua(lua_State* L)
+	{
+		//------------- Audio ------------//
+		lua_newtable(L); // Stack: audio table
+
+        // Playing sounds
+        lua_pushcfunction(L, playFrontendAudioTrackLua);
+        lua_setfield(L, -2, "play_frontend");
+
+        // Setting the volume for sounds and music.
+        lua_pushcfunction(L, setSoundEffectsVolumeLua);
+        lua_setfield(L, -2, "set_sound_volume");
+        // 
+        lua_pushcfunction(L, setMusicVolumeLua);
+        lua_setfield(L, -2, "set_music_volume");
+
+		// audio namespace
+    	lua_setglobal(L, "audio");
+	}
+
+    /**
+     * Start a frontend audio track
+     * Usage:
+     * audio.play_frontend(audio_enums.eSound.SOUND_RAMPAGE_FAILED, 1.0)
+     */
+    int
+    playFrontendAudioTrackLua(lua_State *L)
+    {
+        auto audioTrack = luaL_checknumber(L, 1);
+        auto audioVolume = luaL_checknumber(L, 2);
+        DMAudio.PlayFrontEndSound(audioTrack, audioVolume);
+
+        return 0;
+    }
+
+    /**
+     * Set the sound effects volume.
+     * 
+     * audio.set_sound_volume(1.0)
+     */
+    int
+    setSoundEffectsVolumeLua(lua_State *L)
+    {
+        auto value = luaL_checknumber(L, 1);
+
+        if (value < 0 || value > MAX_VOLUME)
+
+        DMAudio.SetEffectsMasterVolume(value);
+        // Set the volume in the frontend and ini also.
+        FrontEndMenuManager.m_PrefsSfxVolume = value;
+        StoreIni("Audio", "SfxVolume", value);
+        return 0;
+    }
+
+    /**
+     * Set the music volume.
+     * 
+     * audio.set_music_volume(1.0)
+     */
+    int
+    setMusicVolumeLua(lua_State *L)
+    {
+        auto value = luaL_checknumber(L, 1);
+        DMAudio.SetMusicMasterVolume(value);
+        // Set the volume in the frontend and ini also.
+        FrontEndMenuManager.m_PrefsMusicVolume = value;
+	    StoreIni("Audio", "MusicVolume", value);
+        return 0;
+    }
+}
+
+#endif // LUA_TEST
