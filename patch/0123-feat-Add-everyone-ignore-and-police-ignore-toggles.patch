@@ -144,6 +145,18 @@ void RegisterPlayerFunctionsLua(lua_State* L)
 	lua_pushcfunction(L, teleportToMarkerLua);
 	lua_setfield(L, -2, "tp_to_marker");
 
+	// Toggle the players control
+	lua_pushcfunction(L, togglePlayerControlLua);
+	lua_setfield(L, -2, "set_control");
