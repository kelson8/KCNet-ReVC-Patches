+/**
+ * Toggle for allowing hurricanes in the game.
+ * 
+ * TODO Test this, I have not tested it yet but it should work.
+ * 
+ * Usage:
+ * game.set_allow_hurricanes(true)
+ */
+int setAllowHurricanesLua(lua_State *L)
+{
+	// CWeather::ForceHurricaneWeather();
+
+	bool toggle = static_cast<float>(lua_toboolean(L, 1));
+
+	// https://stackoverflow.com/questions/55936608/how-to-check-for-boolean-argument-in-lua-function
+	// I guess I was doing this wrong, I was checking if the boolean was always false, not if it was a boolean..
+	if(!lua_isboolean(L, 1))
+	{
+		return luaL_error(L, "game.set_allow_hurricanes requires a boolean true or false.");
+	}
+
+	CStats::NoMoreHurricanes = toggle;
+
+	return 1;
+}
