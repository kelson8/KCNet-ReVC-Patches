 }
 
+/**
+ * Start a fire
+ * 
+ * Usage in lua:
+ * game.start_fire({x = 2, y = 2, z = 2})
+ */
+int startFireLua(lua_State *L)
+{
+	auto pos = luaGetCVector(L, 1);
+
+	if (!pos)
+    {
+    	return luaL_error(L, "game.start_fire expects a vector table with numeric x, y, and z fields");
+	}
+
+	gFireManager.m_nTotalFires++;
+	gFireManager.StartFire(*pos, 1.0f, false);
+
+	return 1;
+}
