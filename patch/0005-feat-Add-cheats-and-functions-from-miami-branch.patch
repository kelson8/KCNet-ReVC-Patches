+		else
+
+			v = new CAutomobile(id, RANDOM_VEHICLE);
+
+		// Set the vehicle to be owned by the player.
+		v->bHasBeenOwnedByPlayer = true;
+
+		if(CModelInfo::IsBoatModel(id))
