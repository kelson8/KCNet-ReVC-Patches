 int CTheScripts::OpenScript()
 {
 	CFileMgr::ChangeDir("\\");
 	switch (ScriptToLoad) {
+
+#ifdef CUSTOM_CODE
+	case SCRIPT_RELEASE: return CFileMgr::OpenFile("data\\main.scm", "rb");
+	case SCRIPT_FREEROAM_MIAMI: return CFileMgr::OpenFile("data\\freeroam_miami.scm", "rb");
+	case SCRIPT_DEBUG: return CFileMgr::OpenFile("data\\main_d.scm", "rb");
+#else
 	case 0: return CFileMgr::OpenFile("data\\main.scm", "rb");
 	case 1: return CFileMgr::OpenFile("data\\freeroam_miami.scm", "rb");
 	case 2: return CFileMgr::OpenFile("data\\main_d.scm", "rb");
+#endif // CUSTOM_CODE
 	}
 	return CFileMgr::OpenFile("data\\main.scm", "rb");
 }
@@ -757,9 +776,15 @@ void CTheScripts::Init()
 
 	// I'm not sure how to change these, holding 'D' doesn't load in debug but holding 'R' loads in freeroam_miami.scm
 
+#ifdef CUSTOM_CODE
