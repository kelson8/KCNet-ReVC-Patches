@@ -78,6 +77,25 @@
 
 #include <stdlib.h>
 
+namespace Util {
+	namespace Weapon {
+
+		/**
+		 * Check if the weapon is valid for my lua functions.
+		 * @param weaponType The type of weapon to check from the eWeaponType enum.
+		 */
+		bool IsWeaponValid(eWeaponType weaponType)
+		{
+			if(weaponType < WEAPONTYPE_BRASSKNUCKLE || weaponType > WEAPONTYPE_TOTALWEAPONS)
+			{
+				return false;
+			}
+
+			return true;
+		}
+	}
+}
