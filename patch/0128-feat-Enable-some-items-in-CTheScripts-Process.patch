+
+// When creating the coroutine, use this exact order:
+/*
+m_luaThread = lua_newthread(m_mainState);
+
+m_threadReference =
+    luaL_ref(m_mainState, LUA_REGISTRYINDEX);
+*/
+
+/**
+ * 
+ Do not call luaL_ref() on the coroutine state. 
+ The new thread is pushed onto the main state’s stack, so the reference must be created from m_mainState.
+
+Also, do not call the Lua script with lua_pcall() if it uses wait(). 
+Load it with luaL_loadfile(), then execute it using lua_resume() as shown above.
+ * 
+ */
+
