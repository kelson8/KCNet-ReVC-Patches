 /**
@@ -215,15 +227,36 @@ int setPoliceStationRespawnLua(lua_State *L)
 
 	if (!pos)
     {
-    	return luaL_error(
-    	L,
-        	"vehicle.create expects a vector table with numeric x, y, and z fields"
-		);
+    	return luaL_error(L, "game.set_police_respawn expects a vector table with numeric x, y, and z fields" );
