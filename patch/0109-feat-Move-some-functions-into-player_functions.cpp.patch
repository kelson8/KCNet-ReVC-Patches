+{
+    FindPlayerPed()->m_fHealth = CWorld::Players[CWorld::PlayerInFocus].m_nMaxHealth;
+	FindPlayerPed()->m_fArmour = CWorld::Players[CWorld::PlayerInFocus].m_nMaxArmour;
+}
