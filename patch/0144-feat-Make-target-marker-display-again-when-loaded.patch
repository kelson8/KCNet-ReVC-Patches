 #endif // DISABLE_GAME_SCRIPTS - For setting up the player so it doesn't crash pressing new game
+
+#ifdef DISABLE_GAME_SCRIPTS
+			// This just fixes a few issues with the audio not working until the game was paused and unpaused.
+			FastLoader::LoadFreeroamScript();
+#else
 			DoSettingsBeforeStartingAGame();
