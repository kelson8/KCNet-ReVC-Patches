@@ -86,6 +88,45 @@ PlayerFunctions::PlayerFunctions()
 
 }
 
+// New
+
+/**
+ * Get the players current position, mostly for use in my lua scripts.
+ * 
+ * @returns The players current position if they are alive and exist, otherwise return all 0 values.
+ */
+CVector
+PlayerFunctions::GetPosition()
+{
+    // Set a default position of 0.0 to return on all values.
+    CVector pos = CVector(0.0f, 0.0f, 0.0f);
+
+    if(PlayerUtil::IsPlayerSafe() && FindPlayerPed())
+    {
+        pos = FindPlayerCoors();
+        // return FindPlayerCoors();
+        return pos;
+    }
+
+    return pos;
+}
+
+/**
+ * Get the players current heading
+ * 
+ * @returns The players current heading if they are alive and exist, otherwise return all 0 values.
+ */
+float
+PlayerFunctions::GetHeading()
+{
+    if(FindPlayerPed())
+    {
+        return FindPlayerHeading();
+    }
+
+    return 0.0f;
+}
+
