 	// TODO Set a garage here once I get the functions implemented in lua
 	// SET_GARAGE (-886.157 -115.158 9.992) (-882.699 -108.312) (-876.7 -119.83) (15.58) GARAGE_RESPRAY respray_garage3//haiti
 
+	// Register the wait command
+	// This works like the original scripts
+	/*
+	-- Example for OnTick in lua, put this in freeroam-game.lua.
+	function OnTick()
+		while true do
+			game.wait(5000)
+			game.set_time(10, 55)
+		end
+	end
+
+	*/
+    lua_pushlightuserdata(L, owner);
+    lua_pushcclosure(L, gameWaitLua, 1);
+    lua_setfield(L, -2, "wait");
 
     // Game namespace
     lua_setglobal(L, "game");
@@ -901,6 +917,55 @@ int addBlipForVehicleLua(lua_State *L)
 }
 
 
+/**
+ * Implementation of COMMAND_WAIT
+ */
+int gameWaitLua(lua_State* L)
+{
+    LuaTest* instance =
+        static_cast<LuaTest*>(
+            lua_touserdata(L, lua_upvalueindex(1))
+        );
+
+    if (!instance) {
+        return luaL_error(
+            L,
+            "game.wait(): LuaTest instance is null"
+        );
+    }
+
+    LuaThread* thread =
+        instance->FindThread(L);
+
+    if (!thread) {
+        return luaL_error(
+            L,
+            "game.wait(): coroutine not found"
+        );
+    }
+
+    lua_Integer milliseconds =
+        luaL_checkinteger(L, 1);
+
+    if (milliseconds < 0)
+        milliseconds = 0;
+
+    const uint32_t now =
+        CTimer::GetTimeInMilliseconds();
+
+    thread->wakeTime =
+        now + static_cast<uint32_t>(milliseconds);
+
+    thread->waiting = true;
+
+    LogFunctions::LogError(
+        Defines::logFile,
+        "game.wait(): coroutine suspended"
+    );
+
+    return lua_yield(L, 0);
+}
+
 }
 
