diff --git a/src/extras/lua/lua_player.cpp b/src/extras/lua/lua_player.cpp
index 8d0e0dd9..b2484a90 100644
--- a/src/extras/lua/lua_player.cpp
+++ b/src/extras/lua/lua_player.cpp
@@ -78,6 +78,18 @@ void RegisterPlayerFunctionsLua(lua_State* L)
     lua_pushcfunction(L, GetPlayerHealthLua);
     lua_setfield(L, -2, "get_health");
 
+	// Set health
+	lua_pushcfunction(L, setPlayerHealthLua);
+    lua_setfield(L, -2, "set_health");
+
+	// Get armor
+	lua_pushcfunction(L, getPlayerArmorLua);
+    lua_setfield(L, -2, "get_armor");
+
+	// Set armor
+	lua_pushcfunction(L, setPlayerArmorLua);
+    lua_setfield(L, -2, "set_armor");
+
     lua_pushcfunction(L, HealPlayerLua);
     lua_setfield(L, -2, "heal");
 
@@ -400,7 +412,65 @@ int
 GetPlayerHealthLua(lua_State *L)
 {
 	float playerHealth = FindPlayerPed()->m_fHealth;
-	if(playerHealth) { pushFloatToLua(L, playerHealth); }
+	if(playerHealth && PlayerUtil::IsPlayerSafe()) { pushFloatToLua(L, playerHealth); }
+
+	return 1;
+}
+
+/**
+ * Set the players health
+ * 
+ * Usage:
+ * player.set_health(200)
+ */
+
+int setPlayerHealthLua(lua_State *L)
+{
+	int newHealth = lua_tonumber(L, 1);
+
+	if(newHealth <= 0 || newHealth > 200)
+	{
+		return luaL_error(L, "player.set_health requires a number between 1 and 200");
+	}
+
+	if(newHealth && PlayerUtil::IsPlayerSafe())
+	{
+		FindPlayerPed()->m_fHealth = newHealth;
+	}
+
+	return 1;
+}
+
+/**
+ * Get the players armor
+ */
+int getPlayerArmorLua(lua_State *L)
+{
+	float playerArmor = FindPlayerPed()->m_fArmour;
+	if(playerArmor && PlayerUtil::IsPlayerSafe()) { pushFloatToLua(L, playerArmor); }
+
+	return 1;
+}
+
+/**
+ * Set the players armor
+ * 
+ * Usage:
+ * player.set_armor(150)
+ */
+int setPlayerArmorLua(lua_State *L)
+{
+	int newArmor = lua_tonumber(L, 1);
+
+	if(newArmor <= 0 || newArmor > 200)
+	{
+		return luaL_error(L, "player.set_armor requires a number between 1 and 200");
+	}
+
+	if(newArmor && PlayerUtil::IsPlayerSafe())
+	{
+		FindPlayerPed()->m_fArmour = newArmor;
+	}
 
 	return 1;
 }
