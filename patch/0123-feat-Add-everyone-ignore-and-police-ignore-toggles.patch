+	// Toggle everyone ignores the player
+	lua_pushcfunction(L, toggleEveryoneIgnorePlayerLua);
+	lua_setfield(L, -2, "everyone_ignore");
+
+	// Toggle police ignores the player
+	lua_pushcfunction(L, togglePoliceIgnorePlayerLua);
+	lua_setfield(L, -2, "police_ignore");
