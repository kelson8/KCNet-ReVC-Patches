+ * TODO Test this later
+ */
+void LuaTest::StartFunction(const char* functionName)
+{
+    lua_State* threadState = lua_newthread(m_luaVM);
+
+    int reference =
+        luaL_ref(m_luaVM, LUA_REGISTRYINDEX);
+
+    lua_getglobal(m_luaVM, functionName);
+
+    if (!lua_isfunction(m_luaVM, -1)) {
+        lua_pop(m_luaVM, 1);
+        luaL_unref(
+            m_luaVM,
+            LUA_REGISTRYINDEX,
+            reference
+        );
+        return;
+    }
+
+    lua_xmove(m_luaVM, threadState, 1);
+
+    LuaThread thread;
+    thread.state = threadState;
+    thread.registryReference = reference;
+
+    m_threads.push_back(thread);
+
+    LuaThread& current = m_threads.back();
+
+#if LUA_VERSION_NUM >= 504
+    int resultCount = 0;
+    int result = lua_resume(
+        threadState,
+        nullptr,
+        0,
+        &resultCount
+    );
+#else
+    int result = lua_resume(
+        threadState,
+        nullptr,
+        0
+    );
+#endif
+
+    if (result == LUA_YIELD)
+        return;
+
+    if (result == LUA_OK) {
+        current.finished = true;
+        return;
+    }
+
+    const char* error = lua_tostring(threadState, -1);
+
+    LogFunctions::LogError(
+        Defines::logFile,
+        error ? error : "Lua function failed"
+    );
+
+    lua_settop(threadState, 0);
+    current.finished = true;
+}
+
+
+/**
+ * Thread for Timers and COMMAND_WAIT.
+ */
+LuaThread *
+LuaTest::FindThread(lua_State *state)
+{
+    for(LuaThread &thread : m_threads)
+    {
+        if(thread.state == state)
+            return &thread;
+    }
+
+    return nullptr;
+};
+
+/**
+ * Remove threads created by the timer and thread system.
+ */
+void
+LuaTest::RemoveFinishedThreads()
+{
+    for(auto it = m_threads.begin();
+        it != m_threads.end();)
+    {
+        if(!it->finished)
+        {
+            ++it;
+            continue;
+        }
+
+        if(it->registryReference != LUA_NOREF)
+        {
+            luaL_unref(
+                m_luaVM,
+                LUA_REGISTRYINDEX,
+                it->registryReference
+            );
+        }
+
+        it = m_threads.erase(it);
+    }
 }
 
 
