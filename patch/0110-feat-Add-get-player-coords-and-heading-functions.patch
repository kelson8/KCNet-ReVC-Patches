+/**
+ * Check if the player is safe
+ * This checks if the player is being arrested or dead along with some other things.
+ * 
+ * Got the idea from here:
+ * https://github.com/gta-chaos-mod/Trilogy-ASI-Script/blob/3.0/src/gtasa/util/GameUtil.cpp#L322-L377
+ * 
+ * @returns If the player is safe, for things like teleporting.
+ */
+bool
+PlayerUtil::IsPlayerSafe()
+{
+	CPed *pPlayer = FindPlayerPed();
+	if (!pPlayer || !pPlayer->CanSetPedState() || pPlayer->m_fHealth <= 0)
+	{ 
+		return false;
+	}
+
+	switch(pPlayer->m_nPedState) {
+	case PED_ARRESTED: 
+	case PED_ARREST_PLAYER:
+	case PED_DEAD:
+	case PED_DIE: 
+		return false;
+	
+		// TODO What is this for?
+		default:
+		{
+		}
+	}
+
+	if(CCutsceneMgr::IsCutsceneProcessing())
+	{
+		return false;
+	}
+
+	// The ped should be safe
+	return true;
+
+
+}
