diff --git a/.gitea/build.yml b/.gitea/build.yml
new file mode 100644
index 00000000..8ded3097
--- /dev/null
+++ b/.gitea/build.yml
@@ -0,0 +1,38 @@
+version: '1.0'
+
+# Workflow for building for Linux on git push.
+# Adapted from here https://git.internal.kelsoncraft.net/kelson8/KCNet-Linux-Coding/src/branch/main/.gitea/workflows/build.yml
+
+# Set the branch name here
+on:
+  push:
+    branches:
+      - miami-dev
+
+jobs:
+  # Login to the docker registry
+  login-registry:
+    runs-on: ubuntu-24.04
+    steps:
+    - name: Login to local docker registry
+      image: docker.gitea.com/runner-images:ubuntu-24.04
+      run: |
+        docker login registry.internal.kelsoncraft.net -u ${{ secrets.DOCKER_USERNAME }} -p ${{ secrets.DOCKER_PASSWORD }}
+
+  build:
+    # runs-on: ubuntu-24.04
+    runs-on: revc-dev-1.2a
+    steps:
+    # Setup the local container for building. 
+    - name: Setup container
+      image: registry.internal.kelsoncraft.net/kelson8/revc-dev:1.2a
+      # This should build the files.
+      # I'm quite sure this is cached or something.
+      # TODO Make this get the build from the gitea secrets
+      run: |
+        cd /reVC
+        ./premake5Linux --no-git-hash=1 --with-librw gmake2
+        cd ./build
+        make config=debug_linux-amd64-librw_gl3_glfw-oal -j$(nproc)
+        
+        
\ No newline at end of file
