+/**
+ * Kill the player.
+ * Originally Copied from Pad.cpp.
+ * Modified to only run if the player isn't dead, should fix the spamming in lua.
+ */
+void
+PlayerFunctions::Suicide()
+{
+    CPlayerPed *pPlayer = FindPlayerPed();
+	if (!pPlayer->DyingOrDead())
+	{
+        // Is this message really needed here? It's not like the player won't know they died.. Lol.
+        // I could add some explosions to this if chaos mode is enabled.
