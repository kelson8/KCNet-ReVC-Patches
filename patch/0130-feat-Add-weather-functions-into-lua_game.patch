+/**
+ * Get a Vector2D in lua.
+ * 
+ * This is for a CVector2D, which only has X, and Y, for options that don't require the Z value.
+ * 
+ * TODO Test this.
+ * 
+ * This is used like this:
+ * local leftBottom = { x = 25, y = 25 }
+ * local topRight = { x = 25, y = 25 }
+ * ... Use with functions that require a CVector2D.
+ */
+std::optional<CVector2D> luaGetCVector2D(lua_State* L, int index)
+{
+    if (!lua_istable(L, index))
+        return std::nullopt;
+
+    const int absoluteIndex = lua_absindex(L, index);
+
+    lua_getfield(L, absoluteIndex, "x");
+    if (!lua_isnumber(L, -1))
+    {
+        lua_pop(L, 1);
+        return std::nullopt;
+    }
+
+    const float x = static_cast<float>(lua_tonumber(L, -1));
+    lua_pop(L, 1);
+
+    lua_getfield(L, absoluteIndex, "y");
+    if (!lua_isnumber(L, -1))
+    {
+        lua_pop(L, 1);
+        return std::nullopt;
+    }
+
+    const float y = static_cast<float>(lua_tonumber(L, -1));
+    lua_pop(L, 1);
+
+    if (!std::isfinite(x) ||
+        !std::isfinite(y))
+    {
+        return std::nullopt;
+    }
+
+    return CVector2D(x, y);
+}
