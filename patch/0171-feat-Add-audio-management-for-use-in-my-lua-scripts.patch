+     * ped.get_random_char()
+     */
+    int
+    getRandomCharLua(lua_State *L)
+    {
+        int pedHandle = -1;
+        CVector pos = FindPlayerCoors();
+        auto x1 = luaL_checknumber(L, 1);
+        auto y1 = luaL_checknumber(L, 2);
+        auto x2 = luaL_checknumber(L, 3);
+        auto y2 = luaL_checknumber(L, 4);
+
+        int i = CPools::GetPedPool()->GetSize();
+        while(--i && pedHandle == -1)
