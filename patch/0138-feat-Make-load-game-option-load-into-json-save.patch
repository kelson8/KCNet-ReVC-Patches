 src/core/Frontend.cpp              | 50 ++++++++++++++++----------
 src/core/MenuScreensCustom.cpp     |  1 -
 src/extras/utils/defines.cpp       |  2 +-
 src/extras/utils/freeroam_util.cpp | 58 ++++++++++++++++++++++++++++++
 5 files changed, 100 insertions(+), 21 deletions(-)

