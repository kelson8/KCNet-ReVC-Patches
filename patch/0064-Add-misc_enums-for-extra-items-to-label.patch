+// clang-format off
+int8
+//CRunningScript::ProcessCommands1700To1799(int32 command)
+CRunningScript::ProcessCommands1700To1701(int32 command)
+{
+
+	switch(command) {
+	// TODO Test this if I can get it working in gta3sc.
+	// If this works, I can make my own custom events directly in the freeroam_miami.scm
+	case COMMAND_KCNET_TEST:
+	{
+		CollectParameters(&m_nIp, 2);
+		CPed *pPed = CPools::GetPedPool()->GetAt(ScriptParams[0]);
+		script_assert(pPed);
+
+		float playerHealth = *(float*)&ScriptParams[1];
+		pPed->m_fHealth = playerHealth;
+		//break;
+		return 0;
+	}
+	
+	default:
+		script_assert(0);
+	}
+
+	return -1;
+}
+
+#endif
