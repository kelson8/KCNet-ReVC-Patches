+/**
+ * Set the players amount of money.
+ * 
+ * Usage:
+ * player.set_money(value)
+ */
+int 
+setPlayerMoneyLua(lua_State *L)
+{
+	lua_Integer newMoney = luaL_checkinteger(L, 1);
+	CustomCheats::MoneyCheat(newMoney);
+
+	return 0;
+}
+
+/**
+ * Get the players amount of money.
+ * 
+ * Usage:
+ * player.get_money()
+ */
+int
+getPlayerMoneyLua(lua_State *L)
+{
+	int currentMoney = CWorld::Players[CWorld::PlayerInFocus].m_nMoney;
+
+	lua_pushnumber(L, currentMoney);
+	return 1;
+}
