diff --git a/premake5.lua b/premake5.lua
index a1c943ef..579117b9 100644
--- a/premake5.lua
+++ b/premake5.lua
@@ -310,9 +310,6 @@ project "reVC"
 	includedirs { ("src/extras/functions") }
 	includedirs { ("src/extras/kcnet") }
 	includedirs { ("src/extras/utils") }
-	
-	libdirs { "vendor/d3d9/lib" }
-	links { "d3dx9.lib" }
 	--
 
 	includedirs { "src" }
@@ -349,6 +346,12 @@ project "reVC"
 		includedirs { "vendor/opusfile/include" }
 	end
 
+	-- New, only enable d3dx9 lib on Windows..
+	filter "platforms:win*"
+		libdirs { "vendor/d3d9/lib" }
+		links { "d3dx9.lib" }
+	--
+
 	filter "configurations:Vanilla"
 		defines { "VANILLA_DEFINES" }
 
