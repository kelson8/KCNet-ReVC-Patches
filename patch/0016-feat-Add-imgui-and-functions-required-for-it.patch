+#include "log_util.h"
+
+#include "player_util.h"
+#include <iostream>
+
+#include "log_functions.h"
+#include "defines.h"
+
+/// <summary>
+/// Log the current coords to the log file.
+/// Useful for marking locations quickly.
+/// </summary>
+void
+LogUtil::LogCurrentCoords()
+{
+	CPlayerPed *pPed = FindPlayerPed();
+	CVector playerCoords = pPed->GetPosition();
+	float playerX = playerCoords.x;
+	float playerY = playerCoords.y;
+	float playerZ = playerCoords.z;
+
+	std::string playerCoordsString = "Player coords X: " + std::to_string(playerX) + +" Y: " + std::to_string(playerY) + +" Z: " + std::to_string(playerZ);
+
+	LogFunctions::LogInfo(Defines::logFile, playerCoordsString);
+ }
