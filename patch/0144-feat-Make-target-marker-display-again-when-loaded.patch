diff --git a/src/extras/utils/freeroam_util.cpp b/src/extras/utils/freeroam_util.cpp
index 5e63ea86..d33eca2f 100644
--- a/src/extras/utils/freeroam_util.cpp
+++ b/src/extras/utils/freeroam_util.cpp
@@ -432,12 +432,48 @@ bool FreeroamUtil::LoadFreeroamJson()
         // New for loading the target marker position.
         // TODO Fix this to work.
         // It doesn't put the marker back on the map, I will probably have to add the sprite back also.
-        // if(save.contains("map") && save["map"].contains("target_marker"))
-        // {
-        //     const json& mapInfo = save["map"]["target_marker"];
-        //     CRadar::TargetMarkerPos.x = mapInfo.value("pos_x", CRadar::TargetMarkerPos.x);
-        //     CRadar::TargetMarkerPos.y = mapInfo.value("pos_y", CRadar::TargetMarkerPos.y);
-        // }
+        if(save.contains("map") && save["map"].contains("target_marker"))
+        {
+            
+            if (CRadar::TargetMarkerId == -1) 
+            {
+
+
+                const json& mapInfo = save["map"]["target_marker"];
+                CRadar::TargetMarkerPos.x = mapInfo.value("pos_x", CRadar::TargetMarkerPos.x);
+                CRadar::TargetMarkerPos.y = mapInfo.value("pos_y", CRadar::TargetMarkerPos.y);
+                // This is never set for the target marker.
+                CRadar::TargetMarkerPos.z = 0.0f;
+
+                CVector targetMarkerPos = CVector(CRadar::TargetMarkerPos.x, CRadar::TargetMarkerPos.y, 0.0f);
+
+                // This works for making the target marker display!
+                // TODO Move all this into a new function, FreeroamUtil::LoadTargetMarker()
+                // TODO Move this value, and it's a bad idea to set this to 1.
+                int nextBlip = 1;
+                CRadar::TargetMarkerId = CRadar::GetNewUniqueBlipIndex(nextBlip);
+
+                // TODO Move this into another function.
+                // It came from CRadar::ToggleTargetMarker;
+		        CRadar::ms_RadarTrace[nextBlip].m_eBlipType = BLIP_COORD;
+		        CRadar::ms_RadarTrace[nextBlip].m_nColor = RADAR_TRACE_GRAY;
+		        CRadar::ms_RadarTrace[nextBlip].m_bDim = 0;
+		        CRadar::ms_RadarTrace[nextBlip].m_bInUse = 1;
+		        CRadar::ms_RadarTrace[nextBlip].m_Radius = 1.0f;
+		        CRadar::ms_RadarTrace[nextBlip].m_vec2DPos = targetMarkerPos;
+		        CRadar::ms_RadarTrace[nextBlip].m_vecPos = targetMarkerPos;
+		        CRadar::ms_RadarTrace[nextBlip].m_nEntityHandle = 0;
+		        CRadar::ms_RadarTrace[nextBlip].m_wScale = 5;
+		        CRadar::ms_RadarTrace[nextBlip].m_eBlipDisplay = BLIP_DISPLAY_BLIP_ONLY;
+		        CRadar::ms_RadarTrace[nextBlip].m_eRadarSprite = RADAR_SPRITE_WAYPOINT;
+                //
+
+            }
+
+            // To reset the target marker:
+            // ClearBlip(CRadar::TargetMarkerId);
+            // CRadar::TargetMarkerId = -1;
+        }
 
         return true;
     }
