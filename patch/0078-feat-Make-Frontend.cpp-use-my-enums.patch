diff --git a/src/core/Frontend.cpp b/src/core/Frontend.cpp
index 0d29235c..c18412f1 100644
--- a/src/core/Frontend.cpp
+++ b/src/core/Frontend.cpp
@@ -41,6 +41,10 @@
 #include "misc_functions.h"
 #endif // CUSTOM_CODE - Export stats using html template
 
+#ifdef CUSTOM_CODE
+#include "misc_enums.h"
+#endif // CUSTOM_CODE - For new script enums
+
 // Similar story to Hud.cpp:
 // Game has colors inlined in code.
 // For easier modification we collect them here:
@@ -134,6 +138,9 @@ bool CMenuManager::m_PrefsDisableTutorials = false;
 uint32 TimeToStopPadShaking;
 #endif
 
+/**
+ * Music file names and other items.
