diff --git a/src/extras/lua/lua_game.cpp b/src/extras/lua/lua_game.cpp
index 11d92938..2afa508e 100644
--- a/src/extras/lua/lua_game.cpp
+++ b/src/extras/lua/lua_game.cpp
@@ -1130,8 +1130,12 @@ int createHiddenPackageLua(lua_State *L)
  */
 int saveCustomFreeroamLua(lua_State *L)
 {
+#ifdef DISABLE_GAME_SCRIPTS
 	FreeroamUtil::SaveFreeroamJson();
 	CustomCheats::CustomHelpMessage("Game saved");
+#else
+	return luaL_error(L, "game.save is disabled with game scripts enabled!");
+#endif // DISABLE_GAME_SCRIPTS
 	return 0;
 }
 
@@ -1143,8 +1147,13 @@ int saveCustomFreeroamLua(lua_State *L)
  */
 int loadCustomFreeroamLua(lua_State *L)
 {
+#ifdef DISABLE_GAME_SCRIPTS
 	FreeroamUtil::LoadFreeroamJson();
 	CustomCheats::CustomHelpMessage("Game loaded");
+
+#else
+	return luaL_error(L, "game.save is disabled with game scripts enabled!");
+#endif // DISABLE_GAME_SCRIPTS
 	return 0;
 }
 
