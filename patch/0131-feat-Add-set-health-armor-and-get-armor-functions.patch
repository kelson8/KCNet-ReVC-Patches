+	/**
+	 * Switch the ped roads off in the area.
+	 * 
+	 * Usage:
+	 * world.switch_ped_roads_off({x = 25, y = 25, z = 25}, {x = 50, y = 50, z = 50})
+	 */
+	int switchPedRoadsOffLua(lua_State *L)
+	{
+		auto leftBottom = luaGetCVector(L, 1);
+		auto rightTop = luaGetCVector(L, 2);
+	
+		if (!leftBottom || !rightTop)
+    	{
+    		return luaL_error(L, "world.switch_ped_roads_off expects two vector tables with x, y and z values." );
+		}
+
+		ThePaths.SwitchPedRoadsOffInArea(leftBottom.value().x, leftBottom.value().y, leftBottom.value().z,
+										rightTop.value().x, rightTop.value().y, rightTop.value().z, true);
+
+		return 1;
+	}
+
+	/**
+	 * Switch the ped roads on in the area.
+	 * 
+	 * Usage:
+	 * world.switch_ped_roads_on({x = 25, y = 25, z = 25}, {x = 50, y = 50, z = 50})
+	 */
+	int switchPedRoadsOnLua(lua_State *L)
+	{
+		auto leftBottom = luaGetCVector(L, 1);
+		auto rightTop = luaGetCVector(L, 2);
+	
+		if (!leftBottom || !rightTop)
+    	{
+    		return luaL_error(L, "world.switch_ped_roads_on expects two vector tables with x, y and z values." );
+		}
+
 		ThePaths.SwitchPedRoadsOffInArea(leftBottom.value().x, leftBottom.value().y, leftBottom.value().z,
 										rightTop.value().x, rightTop.value().y, rightTop.value().z, false);
+		return 1;
+	}
