+	if(CPad::GetPad(0)->GetChar('R')) ScriptToLoad = SCRIPT_FREEROAM_MIAMI;
+	if(CPad::GetPad(0)->GetChar('D')) ScriptToLoad = SCRIPT_DEBUG;
+#else
 	if(CPad::GetPad(0)->GetChar('G')) ScriptToLoad = 0;
