@@ -779,7 +781,9 @@ givePlayerWeaponLua(lua_State *L)
 		return luaL_error(L, "player.give_weapon requires a weapon type and an amount for the ammo");
 	}
 
-	if (weaponType < WEAPONTYPE_BRASSKNUCKLE || weaponType > WEAPONTYPE_TOTALWEAPONS)
+	// I switched to this function since I got it working.
+	// It is a better way to check if the weapon is valid, so it can be used elsewhere.
+	if(!Util::Weapon::IsWeaponValid(static_cast<eWeaponType>(weaponType)))
 	{
 		return luaL_error(L, "player.give_weapon out of range for values of weaponType enum, please use weapon_enums in freeroam-enums.lua.");
 	}
