+//-------------------------------------------
+
+LuaScript::LuaScript(lua_State* mainState,
+                     const std::string& filename)
+    : m_mainState(mainState),
+      m_luaThread(nullptr),
+      m_threadReference(LUA_NOREF),
+      m_wakeTime(0),
+      m_finished(false),
+      m_filename(filename)
+{
+}
+
+LuaScript::~LuaScript()
+{
+    if (m_threadReference != LUA_NOREF) {
+        luaL_unref(
+            m_mainState,
+            LUA_REGISTRYINDEX,
+            m_threadReference
+        );
+
+        m_threadReference = LUA_NOREF;
+    }
+}
+
+/**
+ * Load a lua script.
+ */
+bool LuaScript::Load()
+{
+    /*
+     * lua_newthread pushes the new coroutine onto m_mainState's stack.
+     */
+    m_luaThread = lua_newthread(m_mainState);
+
+    /*
+     * Store the coroutine in the registry. luaL_ref pops it from the
+     * main state's stack and keeps it alive.
+     */
+    m_threadReference =
+        luaL_ref(m_mainState, LUA_REGISTRYINDEX);
+
+    /*
+     * Load the Lua file onto the coroutine's stack.
+     */
+    int result = luaL_loadfile(
+        m_luaThread,
+        m_filename.c_str()
+    );
+
+    if (result != LUA_OK) {
+        LogFunctions::LogError(Defines::luaLogFile, "Error: Could not load Lua script.");
+        ReportError("Could not load Lua script");
+        m_finished = true;
+        return false;
+    }
+
+    /*
+     * Start immediately, or set this to the current time if you want
+     * the script to start on the next frame.
+     */
+    m_wakeTime = 0;
+
+    return true;
+}
+
+/**
+ * Report an error from lua.
+ */
+void LuaScript::ReportError(const char* reason)
+{
+    const char* error =
+        lua_tostring(m_luaThread, -1);
+
+    printf(
+        "[Lua] %s: %s\n",
+        reason,
+        error ? error : "unknown error"
+    );
+
+    lua_settop(m_luaThread, 0);
+}
+
+/**
+ * Process the lua scripts.
+ * 
+ * TODO Call this from where the other game processing is and my lua OnTick function is.
+ */
+void LuaScript::Process()
+{
+    for (auto it = gLuaScripts.begin();
+         it != gLuaScripts.end();) {
+        LuaScript& script = **it;
+
+        script.Process();
+
+        if (script.IsFinished()) {
+            it = gLuaScripts.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+/**
+ * Implementation of COMMAND_WAIT
+ * 
+ * Sleeps the game for this amount of time like in the scripts.
+ * 
+ * Runs sleep like the original game scripts.
+ * 
+ * Usage (Time in miliseconds):
+ * game.wait(ms)
+ * 
+ * TODO Implement this, I might have this working with the CTimer class.
+ */
+int waitLua(lua_State* L)
+{
+    int milliseconds = 0;
+
+    if (lua_gettop(L) >= 1) {
+        milliseconds =
+            static_cast<int>(
+                luaL_checkinteger(L, 1)
+            );
+    }
+
+    if (milliseconds < 0)
+        milliseconds = 0;
+
+    lua_pushinteger(L, milliseconds);
+
+    /*
+     * Yield one value: the requested wait duration.
+     */
+    return lua_yield(L, 1);
+}
