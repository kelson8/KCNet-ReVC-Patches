+#else
+			DoSettingsBeforeStartingAGame();
+
+#endif // DISABLE_GAME_SCRIPTS - Fix for audio bug on new game.
+
 				break;
 #ifdef LEGACY_MENU_OPTIONS
 			case MENUACTION_RELOADIDE:
