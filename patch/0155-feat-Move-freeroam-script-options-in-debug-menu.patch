+/**
+ * New method for getting the save file path.
+ * This will be used in lua to make sure it always sets the save into the 'ViceExtended' folder.
+ * I will be locking down the lua security a bit later on once I get enough working there.
+ * 
+ * TODO Make this a reference with const std::filesystem::path&, it keeps crashing currently.
+ * 
+ * Currently, my freeroam scripts use lua for fallback loading of the save, which may not be in sync with this code.
+ */
+const std::filesystem::path
+FreeroamUtil::SavePath()
+{
+    // return GetFreeroamSavePath() / (std::string(slot) + ".json");
+	std::string file = saveFileName;
+
+	// std::filesystem::path fullPath = GetFreeroamSavePathNew() / (file + ".json");
+	std::filesystem::path fullPath = GetFreeroamSavePathNew() / (file);
+
+    return fullPath;
+}
